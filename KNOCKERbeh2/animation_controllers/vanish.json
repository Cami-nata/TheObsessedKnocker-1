{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.vanish": {
      "initial_state": "default",
      "states": {
        "default": {
          "transitions": [
            {
              "sleep": "query.is_invisible"
            }
          ]
        },
        "sleep": {
          "on_entry": [
            "/replaceitem entity @s slot.weapon.offhand 1 air 1 0",
            "/tag @s add vanish"
          ],
          "transitions": [
            {
              "default": "!query.is_invisible"
            }
          ],
          "on_exit": [
            "/replaceitem entity @s slot.weapon.offhand 1 air 1 0",
            "/tag @s remove vanish"
          ]
        }
      }
    }
  }
}
